# Supabase Configuration
# Found in Supabase -> Project Settings -> API
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Configure the same two public Supabase values as runtime variables on the
# Cloudflare Worker/Pages Functions deployment. Server-only AI bindings:
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_CONFIG_SECRET=your_random_encryption_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Settings
VITE_APP_NAME="BOM Manager V3"
VITE_APP_ENV=local

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=false
