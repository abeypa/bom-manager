# Supabase browser/client configuration
# Found in Supabase -> Project Settings -> API
# These two VITE_* values are public client configuration values, not admin secrets.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase admin / maintenance configuration
# Used only by local maintenance scripts such as:
#   npm run db:audit
#   npm run db:normalize -- --apply
# Never commit the service role key.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare Worker/Pages secret
# Keep this server-side only. It is used to encrypt OpenRouter settings stored in DB.
OPENROUTER_CONFIG_SECRET=your_random_encryption_secret

# Application Settings
VITE_APP_NAME="BOM Manager V3"
VITE_APP_ENV=local

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=false
